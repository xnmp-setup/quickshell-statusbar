#!/bin/sh
set -eu

# uv's location varies by platform (NixOS ships it system-wide, the
# standalone installer uses ~/.local/bin), so prefer PATH with a fallback.
uv="$(command -v uv || true)"
: "${uv:="${HOME}/.local/bin/uv"}"

exec "$uv" run --script \
  "${HOME}/.local/lib/hypr_status_stream.py" "$@"
